{
  "edit_predictions": {
    "provider": "zed",
  },
  "disable_ai": true,
  "buffer_font_family": "MonaspiceNe Nerd Font",
  "ui_font_family": "SF Pro Text",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "agent": {
    "single_file_review": true,
    "model_parameters": [],
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "git_panel": {
    "status_style": "icon",
  },
  "project_panel": {
    "hide_root": false,
    "entry_spacing": "standard",
  },
  "title_bar": {
    "show_menus": false,
  },
  "tab_bar": {
    "show": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "buffer_line_height": "standard",
  "icon_theme": "Material Icon Theme",
  "vim_mode": true,
  "base_keymap": "VSCode",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Min Dark (Blurred)",
  },
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
    "background": "#101112cc",
    "editor.background": "#101112cc",
    "terminal.background": "#101112cf",
    "panel.background": "#101112cc",
    "status_bar.background": "#101112cc",
    "title_bar.background": "#101112cc",
    "tab_bar.background": "#101112cc",
    "editor.gutter.background": "#101112cc",

    "tab.inactive_background": "#101112cc",
    "tab.active_background": "#131415cc",
    "editor.active_line.background": "#13141566",
    "toolbar.background": "#131415cc",

    "border": "#131415",
    "border.variant": "#131415",
    "panel.focused_border": "#252627",
  },
}
