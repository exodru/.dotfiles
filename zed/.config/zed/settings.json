{
  "disable_ai": true,
  "features": {
    "edit_prediction_provider": "zed",
  },
  "buffer_font_family": "MonaspiceNe Nerd Font",
  "ui_font_family": "SF Pro Text",
  "agent": {
    "single_file_review": true,
    "model_parameters": [],
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "git_panel": {
    "status_style": "icon",
  },
  "project_panel": {
    "hide_root": false,
    "entry_spacing": "standard",
  },
  "title_bar": {
    "show_menus": false,
  },
  "tab_bar": {
    "show": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "buffer_line_height": "standard",
  "icon_theme": "Material Icon Theme",
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Nightfox - opaque",
  },
