# Typography
font=JetBrainsMono Nerd Font 10
markup=1
format=<b>%s</b>\n%b

# Geometry & Placement
width=300
height=200
anchor=top-right
margin=10
padding=10

# Borders & Appearance
border-size=2
border-radius=0

# Urgency: Low
[urgency=low]
background-color=#101112
text-color=#707077
border-color=#D5B4E2
default-timeout=3000

# Urgency: Normal
[urgency=normal]
background-color=#101112
text-color=#eceff4
border-color=#5e81ac
default-timeout=5000

# Urgency: Critical
[urgency=critical]
background-color=#101112
text-color=#eceff4
border-color=#bf616a
default-timeout=0
