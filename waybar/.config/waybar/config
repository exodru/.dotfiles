{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 3,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": [
        "cpu", 
        "memory", 
        "battery", 
        "pulseaudio", 
        "power-profiles-daemon", 
        "sway/language",
        "bluetooth",
        "tray"
    ],

    "sway/language": {
        "format": "  {}",
        "tooltip": false,
        "format-en": "  US",
        "format-ro": "  RO",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "clock": {
        "format": " {:%d %B, %H:%M}",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {used:0.1f}GB"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%"
    },

    "bluetooth": {
        "format": " {status}",
        "format-on": " On",
        "format-off": " Off",
        "format-disabled": " Disabled",
        "format-connected": " Connected",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-bluetooth": "   {volume}%",
        "format-muted": "  Muted",
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
          "default": "",
          "performance": "󰓅  Performance",
          "balanced": "  Balanced",
          "power-saver": "  Powersave"
        }
    },

    "tray": {
        "icon-size": 20,
        "spacing": 10
    }
}
