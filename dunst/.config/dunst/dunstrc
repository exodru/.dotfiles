[global]
    # Typography
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    
    # Geometry & Placement
    width = 300
    height = 200
    origin = top-right
    offset = 10x10
    padding = 10
    horizontal_padding = 10
    
    # Borders & Appearance
    frame_width = 2
    corner_radius = 0
    separator_height = 2
    
    # Behavior
    sort = yes
    word_wrap = yes
    idle_threshold = 120
    sticky_history = yes
    history_length = 20
    show_indicators = yes

[urgency_low]
    background = "#101112"
    foreground = "#707077"
    frame_color = "#434c5e"
    timeout = 3

[urgency_normal]
    background = "#101112"
    foreground = "#eceff4"
    frame_color = "#5e81ac"
    timeout = 5

[urgency_critical]
    background = "#101112"
    foreground = "#eceff4"
    frame_color = "#bf616a"
    timeout = 0
